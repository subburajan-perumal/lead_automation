{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [



        {
            "name": "Python: Gunicorn",
            "type": "python",
            "request": "launch",
            "module": "gunicorn",
            "args":["-c","gunicorn.conf.py"],
            "justMyCode": true
        },
        {
            "name": "Python: Current File",
            "type": "python",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Python: Flask",
            "type": "python",
            "request": "launch",
            "module": "flask",
            "env": {
                "FLASK_APP": "run:app",
                "FLASK_ENV": "development"
            },
            "args": [
                "run",
                "-h",
                "0.0.0.0",
                "--no-debugger"
            ],
            "jinja": true
        },
        {
            "name": "Python: Celery",
            "type": "python",
            "request": "launch",
            "module": "celery",
            "console": "integratedTerminal",
            "args": [
                "-A",
                "app.celery",
                "worker",
                "-l",
                "info",
                "-c",
                "1"
            ]
        }
    ]
}